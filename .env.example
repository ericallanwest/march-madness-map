# Copy to .env and fill in. .env is gitignored; this file is not.
#
# CARTO basemap API key, read by the folium cells in the notebooks. Required
# since CARTO put raster basemaps behind a key in 2026; without it every
# tile carries an "API KEY REQUIRED" watermark. index.html carries the key
# inline, because a static page has nowhere else to keep it.
# Keys: https://carto.com/basemaps/apikey/
CARTO_BASEMAP_KEY=
